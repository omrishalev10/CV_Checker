# Optional: set a key here, or paste it in the app under Settings
AI_API_KEY=
# Legacy aliases also work:
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional username for migrating the original single-user data (default: omri)
OWNER_USERNAME=omri
# Used only to attach the original app password to that account.
APP_PASSWORD=

# Leave both blank for local development — the server then uses a SQLite file
# under DATA_DIR. Set them to run against Turso (required when hosting, since
# free tiers have no persistent disk).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: raises GitHub API rate limits when tailored CVs pull public repos.
# Create a classic token with no scopes, or a fine-grained token with public repo read.
GITHUB_TOKEN=

PORT=3001
DATA_DIR=data
