# Optional: set a key here, or paste it in the app under Settings
AI_API_KEY=
# Legacy aliases also work:
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: locks the app without needing to click through Settings.
# Leave blank to manage the password in the UI instead.
APP_PASSWORD=

# Leave both blank for local development — the server then uses a SQLite file
# under DATA_DIR. Set them to run against Turso (required when hosting, since
# free tiers have no persistent disk).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PORT=3001
DATA_DIR=data
