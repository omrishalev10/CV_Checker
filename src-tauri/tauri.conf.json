{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CareerFit",
  "version": "1.0.0",
  "identifier": "com.careerfit.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w web",
    "beforeBuildCommand": "npm run build -w web"
  },
  "app": {
    "windows": [
      {
        "title": "CareerFit",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
